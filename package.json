{
  "name": "crashscout",
  "private": true,
  "version": "3.0.0-alpha.3",
  "description": "Local, scriptless Android crash discovery by ReporterPlus.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "ReporterPlus",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.reporterplus.crashscout",
    "productName": "CrashScout",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "app/index.html",
      "app/index.js",
      "app/css/main.css",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    }
  }
}
